# Copy this file to .env and fill in your own values. Never commit .env.

# --- LLM (required) ---
GROQ_API_KEY=your_groq_api_key_here
GROQ_MODEL=openai/gpt-oss-120b

# --- Database (required) ---
# Local:  mongodb://localhost:27017
# Atlas:  mongodb+srv://<db_user>:<db_password>@<cluster>.mongodb.net/?retryWrites=true&w=majority
#         (URL-encode special characters in the password, e.g. @ -> %40, # -> %23)
MONGO_URI=mongodb://localhost:27017
MONGO_DB=hr_chatbot_db

# --- CORS: comma-separated frontend origins (no trailing slash) ---
ALLOWED_ORIGINS=http://localhost:5173

MAX_UPLOAD_MB=5

# --- Embeddings: hf | gemini | none (BM25 only) ---
EMBEDDINGS_PROVIDER=none
HF_TOKEN=
HF_EMBED_MODEL=sentence-transformers/all-MiniLM-L6-v2
GEMINI_API_KEY=
GEMINI_EMBED_MODEL=gemini-embedding-001
GEMINI_EMBED_DIM=768

# --- Retrieval tuning ---
RAG_TOP_K=4
RAG_MIN_SCORE=0.2
RAG_HYBRID_ALPHA=0.6
RAG_RELATIVE_CUTOFF=0.5
RAG_CHUNK_CHARS=800
RAG_CHUNK_OVERLAP=120

# Optional: Atlas Vector Search index name on kb_chunks
ATLAS_VECTOR_INDEX=

# Seed demo jobs + sample handbook on first request
AUTO_SEED=true
